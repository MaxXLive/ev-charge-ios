    "NSLocationWhenInUseUsageDescription": {
      "comment": "Permission prompt shown when the app requests the user's location.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje nabíjecí stanice ve vašem okolí a vaši polohu na mapě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Ladestationen in deiner Nähe und deinen Standort auf der Karte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows charging stations near you and your location on the map."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvab läheduses asuvad laadimisjaamad ja teie asukoha kaardil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les bornes de recharge à proximité et votre position sur la carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le stazioni di ricarica vicine a te e la tua posizione sulla mappa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser ladestasjoner i nærheten og posisjonen din på kartet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont laadstations in je buurt en je locatie op de kaart."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra estações de carregamento perto de si e a sua localização no mapa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează stațiile de încărcare din apropiere și locația ta pe hartă."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar laddstationer i närheten och din position på kartan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las estaciones de carga cercanas y tu ubicación en el mapa."
