    "Die Sprache der App folgt den Systemeinstellungen. Über „App-Sprache“ öffnest du die iOS-Einstellungen, um eine andere Sprache nur für EVMap zu wählen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache der App folgt den Systemeinstellungen. Über „App-Sprache“ öffnest du die iOS-Einstellungen, um eine andere Sprache nur für EVMap zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app language follows the system settings. Use “App language” to open the iOS settings and choose a different language just for EVMap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue de l'app suit les réglages du système. Utilisez « Langue de l'app » pour ouvrir les réglages iOS et choisir une autre langue uniquement pour EVMap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua dell'app segue le impostazioni di sistema. Usa “Lingua dell'app” per aprire le impostazioni iOS e scegliere un'altra lingua solo per EVMap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app-taal volgt de systeeminstellingen. Gebruik ‘App-taal’ om de iOS-instellingen te openen en alleen voor EVMap een andere taal te kiezen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma da app segue as definições do sistema. Use “Idioma da app” para abrir as definições do iOS e escolher outro idioma apenas para o EVMap."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appens språk följer systeminställningarna. Använd ”Appspråk” för att öppna iOS-inställningarna och välja ett annat språk enbart för EVMap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appens språk følger systeminnstillingene. Bruk «Appspråk» for å åpne iOS-innstillingene og velge et annet språk kun for EVMap."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk aplikace se řídí nastavením systému. Pomocí „Jazyk aplikace“ otevřete nastavení iOS a zvolíte jiný jazyk jen pro EVMap."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakenduse keel järgib süsteemi seadeid. Vali „Rakenduse keel“, et avada iOS-i seaded ja valida EVMapile eraldi keel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limba aplicației urmează setările sistemului. Folosiți „Limba aplicației” pentru a deschide setările iOS și a alege o altă limbă doar pentru EVMap."
          }
        }
      }
    },
