    "Die Sprache der App folgt den Systemeinstellungen. Über „App-Sprache“ öffnest du die iOS-Einstellungen, um eine andere Sprache nur für EVMap zu wählen." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazyk aplikace se řídí nastavením systému. Pomocí „Jazyk aplikace“ otevřete nastavení iOS a zvolíte jiný jazyk jen pro EVMap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprache der App folgt den Systemeinstellungen. Über „App-Sprache“ öffnest du die iOS-Einstellungen, um eine andere Sprache nur für EVMap zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app language follows the system settings. Use “App language” to open the iOS settings and choose a different language just for EVMap."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakenduse keel järgib süsteemi seadeid. Vali „Rakenduse keel“, et avada iOS-i seaded ja valida EVMapile eraldi keel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue de l'app suit les réglages du système. Utilisez « Langue de l'app » pour ouvrir les réglages iOS et choisir une autre langue uniquement pour EVMap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lingua dell'app segue le impostazioni di sistema. Usa “Lingua dell'app” per aprire le impostazioni iOS e scegliere un'altra lingua solo per EVMap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appens språk følger systeminnstillingene. Bruk «Appspråk» for å åpne iOS-innstillingene og velge et annet språk kun for EVMap."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app-taal volgt de systeeminstellingen. Gebruik ‘App-taal’ om de iOS-instellingen te openen en alleen voor EVMap een andere taal te kiezen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O idioma da app segue as definições do sistema. Use “Idioma da app” para abrir as definições do iOS e escolher outro idioma apenas para o EVMap."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limba aplicației urmează setările sistemului. Folosiți „Limba aplicației” pentru a deschide setările iOS și a alege o altă limbă doar pentru EVMap."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appens språk följer systeminställningarna. Använd ”Appspråk” för att öppna iOS-inställningarna och välja ett annat språk enbart för EVMap."
          }
        }
      }
    },
    "Diese App nutzt ausschließlich von Apple bereitgestellte Frameworks und keine externen Drittanbieter-Bibliotheken." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato aplikace používá výhradně frameworky poskytované společností Apple a žádné externí knihovny třetích stran."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App nutzt ausschließlich von Apple bereitgestellte Frameworks und keine externen Drittanbieter-Bibliotheken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app uses only frameworks provided by Apple and no external third-party libraries."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See rakendus kasutab ainult Apple'i pakutavaid raamistikke ega ühtegi välist kolmanda osapoole teeki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application utilise uniquement des frameworks fournis par Apple et aucune bibliothèque tierce externe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app utilizza esclusivamente framework forniti da Apple e nessuna libreria esterna di terze parti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne appen bruker kun rammeverk levert av Apple og ingen eksterne tredjepartsbiblioteker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app gebruikt uitsluitend door Apple geleverde frameworks en geen externe bibliotheken van derden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app utiliza exclusivamente frameworks fornecidos pela Apple e nenhuma biblioteca externa de terceiros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această aplicație folosește exclusiv framework-uri furnizate de Apple și nicio bibliotecă externă de la terți."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här appen använder endast ramverk från Apple och inga externa tredjepartsbibliotek."
          }
        }
      }
    },
