    "Bitte wähle eine Datenquelle für Ladestationen aus. Du kannst sie später in den Einstellungen der App ändern." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte zdroj dat pro nabíjecí stanice. Později jej můžete změnit v nastavení aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte wähle eine Datenquelle für Ladestationen aus. Du kannst sie später in den Einstellungen der App ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please choose a data source for charging stations. You can change it later in the app settings."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vali laadimisjaamade andmeallikas. Saad seda hiljem rakenduse seadetes muuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez choisir une source de données pour les bornes de recharge. Vous pourrez la modifier plus tard dans les réglages de l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una fonte dati per le stazioni di ricarica. Potrai modificarla in seguito nelle impostazioni dell'app."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en datakilde for ladestasjoner. Du kan endre den senere i appinnstillingene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een gegevensbron voor oplaadpunten. Je kunt deze later in de app-instellingen wijzigen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma fonte de dados para as estações de carregamento. Pode alterá-la mais tarde nas definições da app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți o sursă de date pentru stațiile de încărcare. O puteți modifica ulterior în setările aplicației."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en datakälla för laddstationer. Du kan ändra den senare i appens inställningar."
          }
        }
      }
    },
