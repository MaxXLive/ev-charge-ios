    "Mit Tesla anmelden, um Live-Belegung, Auslastung und Preise zu sehen. Kein Tesla-Fahrzeug nötig." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlaste se přes Tesla a uvidíte aktuální obsazenost, vytížení a ceny. Vozidlo Tesla není potřeba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Tesla anmelden, um Live-Belegung, Auslastung und Preise zu sehen. Kein Tesla-Fahrzeug nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with Tesla to see live availability, utilization and pricing. No Tesla vehicle required."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logi Teslaga sisse, et näha reaalajas saadavust, koormust ja hindu. Tesla sõidukit pole vaja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec Tesla pour voir la disponibilité en direct, le taux d’utilisation et les tarifs. Aucun véhicule Tesla requis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con Tesla per vedere disponibilità in tempo reale, utilizzo e prezzi. Non serve un veicolo Tesla."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg inn med Tesla for å se sanntidstilgjengelighet, bruk og priser. Ingen Tesla-bil nødvendig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in met Tesla om live beschikbaarheid, gebruik en prijzen te zien. Geen Tesla-voertuig nodig."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sessão com a Tesla para ver disponibilidade em tempo real, utilização e preços. Não é necessário um veículo Tesla."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectează-te cu Tesla pentru a vedea disponibilitatea, gradul de utilizare și prețurile în timp real. Nu este nevoie de un vehicul Tesla."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in med Tesla för att se tillgänglighet, beläggning och priser i realtid. Inget Tesla-fordon krävs."
          }
        }
      }
    },
