    "Weitere Quellen werden ergänzt, sobald ihre Anbindung verfügbar ist." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Další zdroje budou přidány, jakmile bude jejich integrace dostupná."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere Quellen werden ergänzt, sobald ihre Anbindung verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More sources will be added as soon as their integration is available."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisaallikad lisatakse kohe, kui nende integratsioon on saadaval."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'autres sources seront ajoutées dès que leur intégration sera disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altre fonti verranno aggiunte non appena la loro integrazione sarà disponibile."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flere kilder legges til så snart integrasjonen er tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er worden meer bronnen toegevoegd zodra de koppeling beschikbaar is."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serão adicionadas mais fontes assim que a sua integração estiver disponível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor fi adăugate mai multe surse de îndată ce integrarea lor va fi disponibilă."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fler källor läggs till så snart deras integration är tillgänglig."
          }
        }
      }
    },
    "Weltweite Abdeckung mit hoher Qualität. Beschreibungen in Englisch oder Landessprache. Von der Community gepflegt und offizielle Verzeichnisse einiger Länder (z.B. Nordamerika, UK, Frankreich, Norwegen)." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celosvětové pokrytí ve vysoké kvalitě. Popisy v angličtině nebo místním jazyce. Spravováno komunitou a oficiálními registry některých zemí (např. Severní Amerika, Velká Británie, Francie, Norsko)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weltweite Abdeckung mit hoher Qualität. Beschreibungen in Englisch oder Landessprache. Von der Community gepflegt und offizielle Verzeichnisse einiger Länder (z.B. Nordamerika, UK, Frankreich, Norwegen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldwide coverage with high quality. Descriptions in English or the local language. Maintained by the community and official registries of some countries (e.g. North America, UK, France, Norway)."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ülemaailmne kõrge kvaliteediga kate. Kirjeldused inglise või kohalikus keeles. Hooldavad kogukond ja mõne riigi ametlikud registrid (nt Põhja-Ameerika, Ühendkuningriik, Prantsusmaa, Norra)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couverture mondiale de haute qualité. Descriptions en anglais ou dans la langue locale. Maintenu par la communauté et les registres officiels de certains pays (p. ex. Amérique du Nord, Royaume-Uni, France, Norvège)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copertura mondiale di alta qualità. Descrizioni in inglese o nella lingua locale. Gestito dalla comunità e dai registri ufficiali di alcuni paesi (es. Nord America, Regno Unito, Francia, Norvegia)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdensomspennende dekning med høy kvalitet. Beskrivelser på engelsk eller lokalspråk. Vedlikeholdt av fellesskapet og offisielle registre i enkelte land (f.eks. Nord-Amerika, Storbritannia, Frankrike, Norge)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wereldwijde dekking van hoge kwaliteit. Beschrijvingen in het Engels of de lokale taal. Onderhouden door de community en officiële registers van sommige landen (bijv. Noord-Amerika, VK, Frankrijk, Noorwegen)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cobertura mundial de alta qualidade. Descrições em inglês ou no idioma local. Mantido pela comunidade e por registos oficiais de alguns países (ex.: América do Norte, Reino Unido, França, Noruega)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acoperire mondială de înaltă calitate. Descrieri în engleză sau în limba locală. Întreținut de comunitate și de registrele oficiale ale unor țări (de ex. America de Nord, Regatul Unit, Franța, Norvegia)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Världsomspännande täckning med hög kvalitet. Beskrivningar på engelska eller lokalspråk. Underhålls av gemenskapen och officiella register i vissa länder (t.ex. Nordamerika, Storbritannien, Frankrike, Norge)."
          }
        }
      }
    },
