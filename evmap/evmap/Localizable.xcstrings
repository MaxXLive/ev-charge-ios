    "Anmelden, um Echtzeitdaten und Preise für Tesla Supercharger zu sehen. Kein Tesla-Fahrzeug nötig." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlaste se a zobrazte data v reálném čase a ceny pro Tesla Supercharger. Vozidlo Tesla není potřeba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmelden, um Echtzeitdaten und Preise für Tesla Supercharger zu sehen. Kein Tesla-Fahrzeug nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to see real-time data and pricing for Tesla Superchargers. No Tesla vehicle required."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logi sisse, et näha Tesla Superchargerite reaalajas andmeid ja hindu. Tesla sõidukit pole vaja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous pour voir les données en temps réel et les tarifs des Superchargeurs Tesla. Aucun véhicule Tesla requis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi per vedere dati in tempo reale e prezzi dei Tesla Supercharger. Non serve un veicolo Tesla."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg inn for å se sanntidsdata og priser for Tesla Superchargere. Ingen Tesla-bil nødvendig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in om realtimegegevens en prijzen voor Tesla Superchargers te zien. Geen Tesla-voertuig nodig."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sessão para ver dados em tempo real e preços dos Superchargers Tesla. Não é necessário um veículo Tesla."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectează-te pentru a vedea date în timp real și prețuri pentru Tesla Supercharger. Nu este nevoie de un vehicul Tesla."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in för att se realtidsdata och priser för Tesla Superchargers. Inget Tesla-fordon krävs."
          }
        }
      }
    },
