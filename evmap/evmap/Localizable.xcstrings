        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere Quellen aktiv: Einträge können doppelt erscheinen. Nicht von allen Quellen unterstützte Filter werden ausgegraut angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multiple sources active: entries may appear twice. Filters not supported by all sources are shown greyed out."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiivseid allikaid on mitu: kirjed võivad ilmuda kaks korda. Filtreid, mida kõik allikad ei toeta, kuvatakse hallina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs sources actives : les entrées peuvent apparaître en double. Les filtres non pris en charge par toutes les sources sont grisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più fonti attive: le voci possono apparire due volte. I filtri non supportati da tutte le fonti sono mostrati in grigio."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flere kilder aktive: oppføringer kan vises to ganger. Filtre som ikke støttes av alle kilder, vises nedtonet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meerdere bronnen actief: items kunnen dubbel verschijnen. Filters die niet door alle bronnen worden ondersteund, worden grijs weergegeven."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Várias fontes ativas: as entradas podem aparecer duas vezes. Os filtros não suportados por todas as fontes são mostrados a cinzento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai multe surse active: intrările pot apărea de două ori. Filtrele neacceptate de toate sursele sunt afișate estompate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flera källor aktiva: poster kan visas dubbelt. Filter som inte stöds av alla källor visas nedtonade."
          }
        }
      }
    },
