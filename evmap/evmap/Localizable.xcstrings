    "%@: %lld %%" : {
      "comment" : "A tooltip that shows the hour and the corresponding load percentage. The argument is the string “%02d:00”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$lld %%"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A button that shows the number of charge points in a cluster. The argument is the number of charge points in the cluster.",
      "isCommentAutoGenerated" : true
    },
