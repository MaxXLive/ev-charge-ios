<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Vorlage für API-Keys. Zum Aktivieren:
    1. Diese Datei nach `Secrets.plist` kopieren (im selben Ordner).
    2. Echte API-Keys eintragen:
       - GoingElectric: anzufragen unter https://www.goingelectric.de/
       - Open Charge Map: kostenlos unter https://openchargemap.org/site/profile/applications
       - Nobil (Skandinavien): kostenlos anzufragen unter https://nobil.no/
       - ENBW_SUBSCRIPTION_KEY: öffentlicher Key aus EVMap Android (MIT) — kann leer bleiben,
         Fallback ist bereits im Code hinterlegt.
  `Secrets.plist` ist via .gitignore vom Commit ausgeschlossen.
  Nicht benötigte Keys einfach leer lassen.
-->
<plist version="1.0">
<dict>
    <key>GOINGELECTRIC_API_KEY</key>
    <string></string>
    <key>OPENCHARGEMAP_API_KEY</key>
    <string></string>
    <key>NOBIL_API_KEY</key>
    <string></string>
    <key>ENBW_SUBSCRIPTION_KEY</key>
    <string></string>
</dict>
</plist>
