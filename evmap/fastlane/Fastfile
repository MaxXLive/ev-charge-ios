default_platform(:ios)

# App Store Connect API key. Set these in fastlane/.env (gitignored) or your
# shell/CI env:
#   ASC_KEY_ID        Key ID      (App Store Connect → Users and Access → Integrations → App Store Connect API)
#   ASC_ISSUER_ID     Issuer ID   (same page, top of the keys list)
#   ASC_KEY_PATH      Path to the downloaded AuthKey_XXXX.p8  (default: fastlane/AuthKey.p8)
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV["ASC_KEY_PATH"] || "fastlane/AuthKey.p8",
    in_house: false
  )
end

# Read MARKETING_VERSION / CURRENT_PROJECT_VERSION from the Xcode project so we
# never hard-code the version here (single source of truth = project.pbxproj).
def marketing_version
  get_version_number(xcodeproj: "evmap.xcodeproj", target: "evmap")
end

platform :ios do
  desc "Verify App Store Connect API key auth and that the app record exists"
  lane :verify do
    api_key = asc_api_key
    build_no = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "de.ermackov.evmap"
    )
    UI.success("Auth OK. Latest TestFlight build: #{build_no}")
  end

  desc "Build a signed release archive (.ipa)"
  lane :build do
    build_app(
      project: "evmap.xcodeproj",
      scheme: "evmap",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )
  end

  desc "Generate localized App Store screenshots via UI test (snapshot) + device frames (frameit)"
  lane :screenshots do
    capture_screenshots # raw screenshots, reads fastlane/Snapfile
    frame_screenshots(path: "./fastlane/screenshots") # wraps each in an Apple device frame
    # frameit outputs frame-native dimensions; pad each *_framed.png to an exact
    # ASC size (6.9" = 1290x2796) so App Store Connect accepts them.
    sh("bash", "pad_framed.sh", "1290x2796")
  end

  desc "Build + upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    increment_build_number(xcodeproj: "evmap.xcodeproj") unless ENV["NO_BUMP"]
    build
    upload_to_testflight(
      api_key: api_key,
      distribute_external: false,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload metadata + screenshots only (no binary)"
  lane :metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      ignore_language_directory_validation: true,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Full release: build, upload binary + metadata + screenshots, submit for review"
  lane :release do
    api_key = asc_api_key
    build
    upload_to_app_store(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
