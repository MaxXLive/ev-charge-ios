# Devices to screenshot. App Store requires a 6.9"/6.7" iPhone shot.
# Add an iPad ("iPad Pro 13-inch (M4)") here if the app ships an iPad listing.
devices([
  "iPhone 17 Pro",
  "iPad Pro 13-inch (M4)"
])

# Languages to capture. These are iOS language codes passed as -AppleLanguages.
# Note: Norwegian is "nb" here; deliver stores it under metadata/no/. snapshot
# maps it automatically. Estonian (et) is omitted: App Store Connect has no
# Estonian storefront localization.
languages([
  "en-US",
  "de-DE",
  "fr-FR",
  "it",
  "nl-NL",
  "sv",
  "nb",
  "cs",
  "pt-PT",
  "ro"
])

scheme("evmapUITests")
output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)
override_status_bar(true) # clean 9:41 / full battery status bar
concurrent_simulators(false)
